
{
  "name": "perp-trading-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Production-ready perp DEX trading terminal: order book, quick buy/sell, limit orders, positions and the Mayhem/Anarchy auto-trading bot UI.",
  "engines": { "node": ">=18.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "serve:dist": "vite preview --port 4173"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}