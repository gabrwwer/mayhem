{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "vitest.config.mts",
    "eslint.config.mjs",
    "scripts/**/*.mjs",
    "packages/*/src/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/bot/src/**/*.ts",
    "services/*/src/**/*.ts",
    "tests/**/*",
    "packages/accounting/analytics/index.ts"
  ]
}