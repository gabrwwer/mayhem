# Mayhem runtime configuration example.
# This file contains NO real credentials.
#
# Safe defaults:
#   DRY_RUN=true
#   TRADING_ENABLED=false
#   BACKRUN_ENABLED=false
#   LAUNCH_ENABLED=false
#
# Copy this file to .env and fill in only the values required for your
# environment. Never commit the real .env.
# Mayhem dashboard — API connection
# Backend must be reachable at this origin. The client normalizes the URL
# to end in exactly one "/api" (VITE_API_URL may or may not include it).
# Local development fallback is http://localhost:3001 when unset.
VITE_API_URL=http://localhost:3001
NODE_ENV=development
LOG_LEVEL=info

# ---------------- Safety ----------------
DRY_RUN=true
TRADING_ENABLED=false

# ---------------- Solana RPC ----------------
RPC_URL_1=https://api.mainnet-beta.solana.com
RPC_URL_2=
RPC_URL_3=
RPC_WS_URL=wss://api.mainnet-beta.solana.com
RPC_COMMITMENT=confirmed
RPC_FAILOVER_MS=150
RPC_TIMEOUT_MS=10000
RPC_MAX_RETRIES=5
RPC_CONFIRM_POLL_MS=300

# Legacy application aliases are retained for compatibility with apps/bot.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_BACKUP_RPC_URL=

# ---------------- Wallet ----------------
# Wallet initialization is skipped while DRY_RUN=true.
WALLET_PROVIDER=encrypted_local
WALLET_FILE_PATH=
WALLET_PASSWORD=
WALLET_SIGNER_URL=

KEYVAULT_DIR=/run/secrets/keys
HOT_WALLET_ID=hot
DEV_WALLET_ID=dev
FEE_WALLET_ID=fee

# ---------------- Jito ----------------
JITO_BUNDLE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_FLOOR_URL=https://bundles.jito.wtf/api/v1/bundles/tip_floor
JITO_TIP_STRATEGY=percentile
JITO_TIP_PERCENTILE=50
JITO_TIP_FIXED_SOL=0.005
JITO_MAX_TIP_SOL=0.02
JITO_MAX_RETRIES=5
JITO_RETRY_BACKOFF_MS=250
JITO_LANDING_TIMEOUT_MS=30000
JITO_LANDING_POLL_MS=300
JITO_TIP_ACCOUNTS_TTL_MS=60000

# ---------------- Snipe / execution controls ----------------
SNIPE_POSITION_SOL=0.5
MAX_SLIPPAGE_PCT=30
MAX_CONCURRENT_POSITIONS=5
MAX_TX_AGE_MS=5000
PREFLIGHT_SIM=true
BACKRUN_ENABLED=false
MIN_WHALE_SOL=1.0
BACKRUN_POSITION_SOL=0.25

# Legacy bot compatibility controls.
MAX_POSITION_SOL=0.1
MAX_OPEN_POSITIONS=3
SLIPPAGE_BPS=100
PRIORITY_FEE_LAMPORTS=100000
COMPUTE_UNIT_LIMIT=300000

# ---------------- Risk ----------------
HONEYPOT_SIM_SELL=true
MINT_AUTHORITY=revoked
MAX_HOLDER_CONCENTRATION_PCT=20
MAX_TOP_HOLDER_PERCENT=20
LP_LOCK_REQUIRED=true
MIN_DEV_WALLET_EXPOSURE_DAYS=30
HOLDER_VELOCITY_MIN_RATE=10
MIN_LIQUIDITY_SOL=3
MIN_HOLDERS=25
REQUIRE_MINT_AUTHORITY_REVOKED=false
REQUIRE_FREEZE_AUTHORITY_REVOKED=true

# ---------------- Circuit breaker ----------------
MAX_DAILY_LOSS_SOL=2
MAX_CONSECUTIVE_LOSSES=3
MAX_DRAWDOWN_PCT=25
TRIP_COOLDOWN_MS=3600000
PERSIST_TRIPS=true

# Legacy compatibility aliases.
MAX_DRAWDOWN_PERCENT=25
BREAKER_COOLDOWN_MS=3600000
RISK_COOLDOWN_MS=5000
MAX_EXPOSURE_SOL=0.3

# ---------------- Exit ladder ----------------
SELL_LADDER=30@2x,30@3x,40@5x
TRAILING_STOP_PCT=25
STOP_LOSS_PCT=40

# Legacy dashboard/bot aliases.
TAKE_PROFIT_PERCENT=100
STOP_LOSS_PERCENT=40
TRAILING_STOP_PERCENT=25
PROFIT_LOCK_ACTIVATION_PERCENT=30
PROFIT_LOCK_PERCENT=10
TRAILING_ACTIVATION_PERCENT=40
AGGRESSIVE_TRAILING_ACTIVATION_PERCENT=80
MAX_HOLD_SECONDS=600
ENTRY_DELAY_MS=0
NEW_LAUNCH_MODE=false
NEW_LAUNCH_MODE_ENABLED=false

# ---------------- Database ----------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=mayhem
PGUSER=mayhem
PGPASSWORD=
PGSSL=false
PG_POOL_SIZE=10
DATABASE_URL=postgresql://mayhem:mayhem@localhost:5432/mayhem_bot

# ---------------- Redis ----------------
REDIS_URL=redis://localhost:6379

# ---------------- API ----------------
# Loopback by default. The API exposes wallet balance, open positions and
# the kill switch — binding 0.0.0.0 must be a deliberate choice.
API_HOST=127.0.0.1
API_PORT=3001
# At least one of API_KEYS / API_AUTH_TOKEN is REQUIRED. The API refuses to
# start without credentials; there is no longer an API_AUTH_DISABLED flag.
API_KEYS=
API_AUTH_TOKEN=
# Shared secret for the bot -> API /internal channel (HMAC-signed).
# REQUIRED. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Dashboard build-time token. Must match one of API_KEYS / API_AUTH_TOKEN,
# or every dashboard request returns 401. This ends up in the browser
# bundle — only serve the dashboard on a trusted network.
VITE_API_TOKEN=

# ---------------- Dashboard ----------------
DASHBOARD_PORT=3000

# ---------------- Notifications ----------------
TG_ENABLED=false
TG_BOT_TOKEN=
TG_CHAT_ID=
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
WEBHOOK_ENABLED=false
WEBHOOK_URL=
ALERT_ON_ENTRY=true
ALERT_ON_EXIT=true
ALERT_ON_TRIP=true
ALERT_ON_KILL_SWITCH=true

# ---------------- Analytics ----------------
EQUITY_SNAPSHOT_INTERVAL_MS=60000
METRICS_ENABLED=true
METRICS_PORT=9090

# ---------------- Launch ----------------
# Disabled by default. Enabling live launch behavior requires explicit
# configuration and human approval.
LAUNCH_ENABLED=false
LAUNCH_BUNDLE_MODE=false
LAUNCH_INITIAL_LIQUIDITY_SOL=1
LAUNCH_ALLOCATION_PCT=50
LAUNCH_REVOKE_MINT_AUTHORITY=true
LAUNCH_BURN_LP=true
LAUNCH_TIP_SOL=0.01

# ---------------- Optional strategy / simulation controls ----------------
MOMENTUM_CONFIRM_ENABLED=false
MOMENTUM_CONFIRM_DURATION_MS=30000
MOMENTUM_CONFIRM_INTERVAL_MS=5000
MIN_MOMENTUM_CHANGE_PCT=2
MIN_MOMENTUM_UPTICK_RATIO=0.6
MAX_MOMENTUM_DRAWDOWN_PCT=10
MIN_MOMENTUM_SAMPLES=4
# ---------------- Request budget ----------------
# Position monitor cadence. Was hardcoded at 250ms = 4 price lookups per
# second PER OPEN POSITION, which starved the discovery and exit-quote
# calls it competed with. Stop-loss latency is bounded by this value.
MONITOR_INTERVAL_MS=1000
# Liquidity monitor polls every watched pool on this interval.
LIQUIDITY_POLL_INTERVAL_MS=10000
# Only process pump.fun mints. The token provider subscribes to every SPL
# Token and Token-2022 mint on Solana; without this filter each one costs
# an enrichment pass and a risk-evidence lookup. The Raydium path cannot
# currently be priced or risk-scored, so those tokens are rejected anyway.
PUMPFUN_ONLY=true
# Allow entries on verified Raydium pools. The verifier confirms program
# ownership, a decodable AMM-V4/CPMM layout, a token/WSOL pair, matching
# vault mints and a positive SOL reserve. It does NOT verify that the LP is
# locked or burned, so a verified pool can still be rugged by its deployer.
# Setting this true also implicitly allows non-pump.fun tokens through.
RAYDIUM_ENTRIES_ENABLED=false

# Discovery providers, switchable independently because their costs differ
# by an order of magnitude:
#   SPL     - subscribes to SPL Token + Token-2022 logs (every mint on
#             Solana) and reads a parsed transaction per candidate. This is
#             the firehose; it is how pump.fun launches are caught at mint.
#   RAYDIUM - subscribes to the two Raydium programs only. Much lower
#             volume, and the correct source for LP-launched tokens.
# Running both pays for the entire Solana mint stream regardless of which
# venue you actually trade.
ENABLE_SPL_PROVIDER=true
ENABLE_RAYDIUM_PROVIDER=false

# Max concurrent discovery evaluations. Excess events are dropped rather
# than queued, so RPC usage stays bounded no matter the chain's event rate.
DISCOVERY_CONCURRENCY=2
# Display-only enrichment; disable first when RPC is the constraint.
ENRICHMENT_ENABLED=true
# Graduation poll: one RPC call per pending mint per tick, so it is both
# aged out and batched.
GRADUATION_POLL_MS=30000
GRADUATION_MAX_AGE_MS=3600000
GRADUATION_BATCH=20

MIN_RISK_SCORE=80
# Share of observed pool liquidity a single entry may consume (bps).
MAX_LIQUIDITY_PARTICIPATION_BPS=100
# Beyond this the engine refuses to evaluate exit conditions against a
# remembered price and force-exits instead of trading blind.
MAX_PRICE_AGE_MS=15000
# Back-off after a take-profit is skipped on net-of-fee P&L, so the 250ms
# monitor loop does not re-quote every tick.
TAKE_PROFIT_RETRY_DELAY_MS=10000
MAX_ENTRY_PRICE_IMPACT_BPS=500
MAX_QUOTE_AGE_MS=5000
MAX_SELL_PRICE_IMPACT_PERCENT=500
EXIT_RETRY_MAX_ATTEMPTS=3
EXIT_RETRY_DELAY_MS=2000
SIM_FAILURE_RATE=0
SIM_INITIAL_SOL=10
SIM_VOLATILITY=0.05
MEMPOOL_SNIPE_ENABLED=false

# ---------------- RapidLaunch ----------------
# Leave blank unless a documented endpoint and credential are configured.
RAPIDLAUNCH_API_URL=
RAPIDLAUNCH_API_KEY=