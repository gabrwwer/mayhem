# MAYHEM dashboard — build-time environment.
#
# Copy to `.env.local` and fill in. Vite inlines `import.meta.env.*` at build
# time, so the dev server must be RESTARTED after any change here — a reload
# is not enough.
#
# SECURITY: VITE_API_TOKEN is compiled into the browser bundle and is readable
# by anyone who can load the page. That is only acceptable because the API
# binds loopback and this dashboard is served on a trusted network. Do not
# expose the dashboard publicly on the strength of this token alone — put an
# authenticating proxy in front.

# Must match API_AUTH_TOKEN, or one entry of API_KEYS, in apps/bot/.env.
# Without it every request returns 401 and the terminal reports API OFFLINE.
VITE_API_TOKEN=

# Optional. Defaults to http://localhost:3001/api when the dashboard is served
# from localhost, which matches API_PORT=3001 in apps/bot/.env. Set it only if
# the API runs on a different host or port.
# VITE_API_URL=http://localhost:3001
