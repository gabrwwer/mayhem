
{
  "name": "@mayhem/execution",
  "version": "0.1.0",
  "private": true,
  "description": "Execution service entry point for signing and broadcasting approved orders.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "require": "./dist/*.js",
      "import": "./src/*.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "dependencies": {
    "@mayhem/core-types": "workspace:*",
    "@mayhem/risk-engine": "workspace:*",
    "@mayhem/token-monitor": "workspace:*",
    "@mayhem/solana": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.0",
    "decimal.js": "^10.4.3",
    "bs58": "^5.0.0"
  }
}
