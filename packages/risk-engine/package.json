
{
  "name": "@mayhem/risk-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Synchronous pre-trade risk gate. Every order passes through it or does not trade.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "require": "./dist/*.js",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean"
  },
  "dependencies": {
    "@mayhem/core-types": "workspace:*",
    "zod": "3.25.76"
  }
}