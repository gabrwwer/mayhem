{
  "name": "@mayhem/lp-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Pure, observational models for pool lifecycle, reserve provenance and LP health. No I/O, no trading impact.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "require": "./dist/*.js",
      "import": "./src/*.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "test": "vitest run --config ../../vitest.config.mts"
  },
  "dependencies": {
    "@mayhem/core-types": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
