
{
  "name": "@mayhem/database",
  "version": "0.0.1",
  "private": true,
  "description": "PostgreSQL persistence client for the Mayhem bot.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src/migrations"],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "migrate": "node ./dist/migrate.js",
    "migrate:dev": "ts-node ./src/migrate.ts",
    "test": "pnpm -w exec vitest run --config ./vitest.config.mts ./packages/database"
  },

  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.1",
    "@types/node": "^20.6.0"
  }
}
